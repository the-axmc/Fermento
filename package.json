{
  "name": "fermento",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:clients",
    "start": "npm run dev",
    "build": "tsc -b && vite build",
    "prebuild": "npm run build:clients",
    "build:clients": "npm run build --workspaces --if-present",
    "bindings": "scripts/bindings.sh",
    "install:contracts": "npm run build:clients",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier . --write",
    "prepare": "husky install",
    "sensor": "node --experimental-strip-types scripts/sensor-sim.ts",
    "producer-api": "node --experimental-strip-types scripts/producer-api.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1",
    "batch_registry_contract": "file:packages/batch_registry_contract",
    "batch_shares_contract": "file:packages/batch_shares_contract",
    "condition_oracle_contract": "file:packages/condition_oracle_contract",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.1",
    "smart-account-kit": "^0.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-dom": "^1.48.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-x": "^1.51.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.1",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,md,html,css,scss,yaml,yml}": "prettier --write"
  }
}
